{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "akhila-adf-dev"
		},
		"ls_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls'"
		},
		"ls_source_sqlserver_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_source_sqlserver'"
		},
		"ls_target_sqlserver_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_target_sqlserver'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://akhilaadlsaccount.dfs.core.windows.net/"
		},
		"ls_source_sqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "akhitargetsqlserverdev.database.windows.net"
		},
		"ls_source_sqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "targetdatabasesql_Copy"
		},
		"ls_source_sqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "takhila"
		},
		"ls_target_sqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "akhitargetsqlserverdev.database.windows.net"
		},
		"ls_target_sqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "targetdatabasesql"
		},
		"ls_target_sqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "takhila"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_adls_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_adls_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_source_sqlserver')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_source_sqlserver_properties_typeProperties_server')]",
					"database": "[parameters('ls_source_sqlserver_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_source_sqlserver_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_source_sqlserver_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_target_sqlserver')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_target_sqlserver_properties_typeProperties_server')]",
					"database": "[parameters('ls_target_sqlserver_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_target_sqlserver_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_target_sqlserver_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/copy file')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"runtimeState": "Stopped",
				"pipelines": [],
				"type": "ScheduleTrigger",
				"typeProperties": {
					"recurrence": {
						"frequency": "Week",
						"interval": 1,
						"startTime": "2025-02-04T14:08:00",
						"timeZone": "India Standard Time",
						"schedule": {
							"minutes": [
								10
							],
							"hours": [
								10
							],
							"weekDays": [
								"Saturday",
								"Sunday"
							]
						}
					}
				}
			},
			"dependsOn": []
		},
