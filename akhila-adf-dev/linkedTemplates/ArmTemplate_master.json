{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "akhila-adf-dev"
		},
		"ls_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls'"
		},
		"ls_source_sqlserver_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_source_sqlserver'"
		},
		"ls_target_sqlserver_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_target_sqlserver'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://akhilaadlsaccount.dfs.core.windows.net/"
		},
		"ls_source_sqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "akhitargetsqlserverdev.database.windows.net"
		},
		"ls_source_sqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "targetdatabasesql_Copy"
		},
		"ls_source_sqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "takhila"
		},
		"ls_target_sqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "akhitargetsqlserverdev.database.windows.net"
		},
		"ls_target_sqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "targetdatabasesql"
		},
		"ls_target_sqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "takhila"
		},
		"tumblingwindow_trigger_properties_pipeline_parameters_strartdate": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowStartTime"
		},
		"tumblingwindow_trigger_properties_pipeline_parameters_enddate": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowEndTime"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "akhila-adf-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_accountKey": {
						"value": "[parameters('ls_adls_accountKey')]"
					},
					"ls_source_sqlserver_password": {
						"value": "[parameters('ls_source_sqlserver_password')]"
					},
					"ls_target_sqlserver_password": {
						"value": "[parameters('ls_target_sqlserver_password')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_source_sqlserver_properties_typeProperties_server": {
						"value": "[parameters('ls_source_sqlserver_properties_typeProperties_server')]"
					},
					"ls_source_sqlserver_properties_typeProperties_database": {
						"value": "[parameters('ls_source_sqlserver_properties_typeProperties_database')]"
					},
					"ls_source_sqlserver_properties_typeProperties_userName": {
						"value": "[parameters('ls_source_sqlserver_properties_typeProperties_userName')]"
					},
					"ls_target_sqlserver_properties_typeProperties_server": {
						"value": "[parameters('ls_target_sqlserver_properties_typeProperties_server')]"
					},
					"ls_target_sqlserver_properties_typeProperties_database": {
						"value": "[parameters('ls_target_sqlserver_properties_typeProperties_database')]"
					},
					"ls_target_sqlserver_properties_typeProperties_userName": {
						"value": "[parameters('ls_target_sqlserver_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "akhila-adf-dev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"tumblingwindow_trigger_properties_pipeline_parameters_strartdate": {
						"value": "[parameters('tumblingwindow_trigger_properties_pipeline_parameters_strartdate')]"
					},
					"tumblingwindow_trigger_properties_pipeline_parameters_enddate": {
						"value": "[parameters('tumblingwindow_trigger_properties_pipeline_parameters_enddate')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'akhila-adf-dev_ArmTemplate_0')]"
			]
		}
	]
}